{% extends 'admin_base.html.twig' %}

{% block title %}Admin - Manage Users{% endblock %}
{% block page_title %}Manage Users{% endblock %}

{% block content %}
<!-- Header with Add Button -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-1">User Management</h5>
        <p class="text-muted mb-0">Manage all users and their roles</p>
    </div>
    <a href="{{ path('app_utilisateur_new') }}" class="btn btn-primary-custom">
        <i class="fas fa-user-plus me-2"></i>
        Add New User
    </a>
</div>

<!-- Users Table -->
<div class="admin-card">
    <div class="card-body-custom p-0">
        {% if users|length > 0 %}
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">User</th>
                        <th>Role</th>
                        <th>Email</th>
                        <th>Joined</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="avatar-circle me-3">
                                    {{ user.username|first|upper }}
                                </div>
                                <div>
                                    <h6 class="mb-0">{{ user.username }}</h6>
                                    <small class="text-muted">User Account</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            {% if user.role == 'ADMIN' %}
                                <span class="badge-danger-custom">
                                    <i class="fas fa-shield-alt me-1"></i>
                                    Administrator
                                </span>
                            {% else %}
                                <span class="badge-success-custom">
                                    <i class="fas fa-user me-1"></i>
                                    Client
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            <span class="text-muted">{{ user.email }}</span>
                        </td>
                        <td>
                            <span class="text-muted">{{ user.createdAt|date('d/m/Y') }}</span>
                            <br>
                            <small class="text-muted">{{ user.createdAt|date('H:i') }}</small>
                        </td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                <a href="{{ path('app_utilisateur_show', {'id': user.id}) }}" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_utilisateur_edit', {'id': user.id}) }}" class="btn btn-outline-warning btn-sm">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="{{ path('app_utilisateur_delete', {'id': user.id}) }}" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                    <button class="btn btn-outline-danger btn-sm">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="text-center py-5">
            <i class="fas fa-users fa-3x text-muted mb-3"></i>
            <h5 class="text-muted mb-3">No Users Found</h5>
            <p class="text-muted mb-4">Start by adding users to the system.</p>
            <a href="{{ path('app_utilisateur_new') }}" class="btn btn-primary-custom">
                <i class="fas fa-user-plus me-2"></i>
                Add Your First User
            </a>
        </div>
        {% endif %}
    </div>
</div>

<!-- User Statistics -->
<div class="row mt-4">
    <div class="col-md-4">
        <div class="admin-card text-center">
            <div class="card-body-custom">
                <i class="fas fa-users fa-2x text-primary mb-2"></i>
                <h4 class="mb-1">{{ users|length }}</h4>
                <p class="text-muted mb-0">Total Users</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-card text-center">
            <div class="card-body-custom">
                <i class="fas fa-shield-alt fa-2x text-danger mb-2"></i>
                <h4 class="mb-1">{{ users|filter(user => user.role == 'ADMIN')|length }}</h4>
                <p class="text-muted mb-0">Administrators</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-card text-center">
            <div class="card-body-custom">
                <i class="fas fa-user fa-2x text-success mb-2"></i>
                <h4 class="mb-1">{{ users|filter(user => user.role == 'CLIENT')|length }}</h4>
                <p class="text-muted mb-0">Clients</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
