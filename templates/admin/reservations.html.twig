{% extends 'admin_base.html.twig' %}

{% block title %}Admin - Manage Reservations{% endblock %}
{% block page_title %}Manage Reservations{% endblock %}

{% block content %}
<!-- Header with Add Button -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-1">Reservation Management</h5>
        <p class="text-muted mb-0">Manage all venue reservations and bookings</p>
    </div>
    <a href="{{ path('app_reservation_controller_c_new') }}" class="btn btn-primary-custom">
        <i class="fas fa-calendar-plus me-2"></i>
        Add New Reservation
    </a>
</div>

<!-- Reservations Table -->
<div class="admin-card">
    <div class="card-body-custom p-0">
        {% if reservations|length > 0 %}
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Reservation</th>
                        <th>Venue</th>
                        <th>Customer</th>
                        <th>Date & Time</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for reservation in reservations %}
                    <tr>
                        <td class="ps-4">
                            <div>
                                <h6 class="mb-0">Booking #{{ loop.index }}</h6>
                                <small class="text-muted">Created {{ reservation.createdAt|date('d/m/Y') }}</small>
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="avatar-circle-venue me-3">
                                    {{ reservation.local.nom|first|upper }}
                                </div>
                                <div>
                                    <h6 class="mb-0">{{ reservation.local.nom }}</h6>
                                    <small class="text-muted">{{ reservation.local.adresse }}</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="text-dark">{{ reservation.utilisateur.username }}</span>
                            <br>
                            <small class="text-muted">{{ reservation.utilisateur.email }}</small>
                        </td>
                        <td>
                            <strong>{{ reservation.date|date('d M Y') }}</strong>
                            <br>
                            <small class="text-muted">{{ reservation.heureDebut|date('H:i') }} - {{ reservation.heureFin|date('H:i') }}</small>
                        </td>
                        <td>
                            {% if reservation.statut == 'Confirmée' %}
                                <span class="badge-success-custom">
                                    <i class="fas fa-check-circle me-1"></i>
                                    Confirmed
                                </span>
                            {% elseif reservation.statut == 'En attente' %}
                                <span class="badge-warning-custom">
                                    <i class="fas fa-clock me-1"></i>
                                    Pending
                                </span>
                            {% elseif reservation.statut == 'Annulée' %}
                                <span class="badge-danger-custom">
                                    <i class="fas fa-times-circle me-1"></i>
                                    Cancelled
                                </span>
                            {% else %}
                                <span class="badge-info-custom">
                                    <i class="fas fa-question-circle me-1"></i>
                                    {{ reservation.statut }}
                                </span>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                <a href="{{ path('app_reservation_controller_c_show', {'id': reservation.id}) }}" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_reservation_controller_c_edit', {'id': reservation.id}) }}" class="btn btn-outline-warning btn-sm">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="{{ path('app_reservation_controller_c_delete', {'id': reservation.id}) }}" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this reservation?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reservation.id) }}">
                                    <button class="btn btn-outline-danger btn-sm">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="text-center py-5">
            <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
            <h5 class="text-muted mb-3">No Reservations Found</h5>
            <p class="text-muted mb-4">Start by adding reservations to manage bookings.</p>
            <a href="{{ path('app_reservation_controller_c_new') }}" class="btn btn-primary-custom">
                <i class="fas fa-calendar-plus me-2"></i>
                Add Your First Reservation
            </a>
        </div>
        {% endif %}
    </div>
</div>

<!-- Reservation Statistics -->
<div class="row mt-4">
    <div class="col-md-3">
        <div class="admin-card text-center">
            <div class="card-body-custom">
                <i class="fas fa-calendar fa-2x text-primary mb-2"></i>
                <h4 class="mb-1">{{ reservations|length }}</h4>
                <p class="text-muted mb-0">Total Reservations</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-card text-center">
            <div class="card-body-custom">
                <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                <h4 class="mb-1">{{ reservations|filter(r => r.statut == 'Confirmée')|length }}</h4>
                <p class="text-muted mb-0">Confirmed</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-card text-center">
            <div class="card-body-custom">
                <i class="fas fa-clock fa-2x text-warning mb-2"></i>
                <h4 class="mb-1">{{ reservations|filter(r => r.statut == 'En attente')|length }}</h4>
                <p class="text-muted mb-0">Pending</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-card text-center">
            <div class="card-body-custom">
                <i class="fas fa-times-circle fa-2x text-danger mb-2"></i>
                <h4 class="mb-1">{{ reservations|filter(r => r.statut == 'Annulée')|length }}</h4>
                <p class="text-muted mb-0">Cancelled</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
