{% extends 'admin_base.html.twig' %}

{% block title %}Admin - Manage Venues{% endblock %}
{% block page_title %}Manage Venues{% endblock %}

{% block content %}
<!-- Header with Add Button -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-1">Venue Management</h5>
        <p class="text-muted mb-0">Manage all venues in your system</p>
    </div>
    <a href="{{ path('app_local_new') }}" class="btn btn-primary-custom">
        <i class="fas fa-plus me-2"></i>
        Add New Venue
    </a>
</div>

<!-- Venues Grid -->
<div class="row">
    {% if venues|length > 0 %}
        {% for venue in venues %}
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="admin-card h-100">
                <div class="card-body-custom">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="venue-icon">
                            <i class="fas fa-building fa-2x text-primary"></i>
                        </div>
                        <div class="venue-status">
                            {% if venue.disponible %}
                                <span class="badge-success-custom">
                                    <i class="fas fa-check-circle me-1"></i>
                                    Available
                                </span>
                            {% else %}
                                <span class="badge-danger-custom">
                                    <i class="fas fa-times-circle me-1"></i>
                                    Unavailable
                                </span>
                            {% endif %}
                        </div>
                    </div>
                    
                    <h5 class="venue-name mb-2">{{ venue.nom }}</h5>
                    <p class="venue-address text-muted mb-3">
                        <i class="fas fa-map-marker-alt me-1"></i>
                        {{ venue.adresse }}
                    </p>
                    
                    {% if venue.description %}
                    <p class="venue-description text-muted mb-3">{{ venue.description|slice(0, 100) }}{% if venue.description|length > 100 %}...{% endif %}</p>
                    {% endif %}
                    
                    <div class="venue-details mb-3">
                        <div class="row">
                            <div class="col-6">
                                <small class="text-muted d-block">Capacity</small>
                                <strong>{{ venue.capacite }} people</strong>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">Price/Hour</small>
                                <strong>€{{ venue.prix }}</strong>
                            </div>
                        </div>
                    </div>
                    
                    <div class="venue-actions">
                        <div class="btn-group w-100" role="group">
                            <a href="{{ path('app_local_show', {'id': venue.id}) }}" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="{{ path('app_local_edit', {'id': venue.id}) }}" class="btn btn-outline-warning btn-sm">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="post" action="{{ path('app_local_delete', {'id': venue.id}) }}" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this venue?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ venue.id) }}">
                                <button class="btn btn-outline-danger btn-sm">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    {% else %}
        <div class="col-12">
            <div class="text-center py-5">
                <i class="fas fa-building fa-3x text-muted mb-3"></i>
                <h5 class="text-muted mb-3">No Venues Found</h5>
                <p class="text-muted mb-4">Start by adding venues to your system.</p>
                <a href="{{ path('app_local_new') }}" class="btn btn-primary-custom">
                    <i class="fas fa-plus me-2"></i>
                    Add Your First Venue
                </a>
            </div>
        </div>
    {% endif %}
</div>

<!-- Venue Statistics -->
<div class="row mt-4">
    <div class="col-md-3">
        <div class="admin-card text-center">
            <div class="card-body-custom">
                <i class="fas fa-building fa-2x text-primary mb-2"></i>
                <h4 class="mb-1">{{ venues|length }}</h4>
                <p class="text-muted mb-0">Total Venues</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-card text-center">
            <div class="card-body-custom">
                <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                <h4 class="mb-1">{{ venues|filter(v => v.disponible)|length }}</h4>
                <p class="text-muted mb-0">Available</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-card text-center">
            <div class="card-body-custom">
                <i class="fas fa-times-circle fa-2x text-danger mb-2"></i>
                <h4 class="mb-1">{{ venues|filter(v => not v.disponible)|length }}</h4>
                <p class="text-muted mb-0">Unavailable</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-card text-center">
            <div class="card-body-custom">
                <i class="fas fa-euro-sign fa-2x text-warning mb-2"></i>
                <h4 class="mb-1">€{{ venues|map(v => v.prix)|reduce((carry, price) => carry + price, 0)|number_format(0) }}</h4>
                <p class="text-muted mb-0">Total Value</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
